# Copy to .env and change the password before deploying.
POSTGRES_USER=predix
POSTGRES_PASSWORD=change-me
POSTGRES_DB=predix

# Port the API and dashboard are published on
API_PORT=8090

# Number of uvicorn worker processes
WEB_CONCURRENCY=2

# Simulator settings
SIM_TURBINES=6
SIM_INTERVAL_SECONDS=2
SIM_FAULT_PROBABILITY=0.005
